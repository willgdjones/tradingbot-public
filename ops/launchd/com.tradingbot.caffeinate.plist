<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.tradingbot.caffeinate</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/caffeinate</string>
		<string>-dimsu</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/USER/Documents/tradingbot/logs/com.tradingbot.caffeinate.err.log</string>
	<key>StandardOutPath</key>
	<string>/Users/USER/Documents/tradingbot/logs/com.tradingbot.caffeinate.out.log</string>
	<key>WorkingDirectory</key>
	<string>/Users/USER/Documents/tradingbot</string>
</dict>
</plist>
