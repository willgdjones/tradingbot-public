#!/bin/bash
# Run a command with the tradingbot secrets in its environment.
#   ops/with-secrets uv run python -m tradingbot...
# Values come from 1Password (item env-tradingbot, Dev vault) via the
# read-only local-automation service account, whose token is ~/.config/op/token.
# They exist only in the child's environment, never on disk. .env holds
# ${NAME} placeholders that python-dotenv fills from this environment.
set -euo pipefail
REPO="$HOME/Documents/tradingbot"
TOKEN_FILE="$HOME/.config/op/token"
[ -r "$TOKEN_FILE" ] || { echo "with-secrets: missing $TOKEN_FILE" >&2; exit 78; }
OP_SERVICE_ACCOUNT_TOKEN="$(cat "$TOKEN_FILE")" exec /usr/local/bin/op run --no-masking \
  --env-file="$REPO/ops/secrets.env" -- "$@"
