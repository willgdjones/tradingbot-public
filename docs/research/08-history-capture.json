    "query": "\n    SELECT c.venue,c.category,\n           coalesce(t.metadata->'historical'->>'maker_fill_eligible','unspecified') AS maker_fill_eligible,\n           t.metadata->'historical'->'source'->>'dataset' AS source_dataset,\n           count(*) AS stored_trade_rows,\n           count(DISTINCT t.external_trade_id) AS distinct_execution_identities,\n           count(*) FILTER (WHERE t.external_trade_id IS NULL) AS rows_without_execution_identity,\n           count(*) FILTER (WHERE t.external_trade_id IS NOT NULL)\n             - count(DISTINCT (t.instrument_id,t.external_trade_id)) FILTER (WHERE t.external_trade_id IS NOT NULL)\n             AS duplicate_instrument_identities\n    FROM trades t JOIN history_row_audit c ON c.instrument_id=t.instrument_id\n    GROUP BY c.venue,c.category,maker_fill_eligible,source_dataset\n    ORDER BY c.venue,c.category,maker_fill_eligible,source_dataset\n",
